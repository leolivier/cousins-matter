#: tests/tests_onboarding_e2e.py:189 views/views_signup.py:94
msgid ""
"Your new family space has been created! You will now receive an email to verify your "
"email address. Click in the link inside the mail to finish the registration."
msgstr "¡Ya se ha creado tu nuevo espacio familiar! Ahora recibirás un correo electrónico para verificar tu "
"dirección de correo electrónico. Haz clic en el enlace que aparece en el correo para completar el registro."
"¡Tu familia ha sido creada! Ahora recibirás un correo para verificar tu "
"dirección. Haz clic en el enlace del mensaje para terminar el registro."

#: tests/tests_onboarding_e2e.py:213
msgid "Member successfully created"
msgstr "Se ha creado correctamente el usuario"

#: tests/tests_onboarding_e2e.py:233
msgid "Registration request sent."
msgstr "Se ha enviado la solicitud de inscripción."

#: tests/tests_onboarding_e2e.py:237
