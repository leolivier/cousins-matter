#, python-format
msgid "Hello %(username)s, your account is now active! You can now sign in."
msgstr "Hola, %(username)s, ¡tu cuenta ya está activa! Ya puedes iniciar sesión."

#: tests/tests_onboarding_e2e.py:291
msgid "Invalid link. Please contact the administrator."
msgstr "Enlace no válido. Ponte en contacto con el administrador."

#: views/views_manage.py:39
