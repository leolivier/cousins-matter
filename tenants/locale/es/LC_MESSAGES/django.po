msgstr "Ya existe un miembro con esta dirección de correo."

#: views/views_signup.py:94
msgid ""
"Your family has been created! You will now receive an email to verify your "
"email address. Click in the link inside the mail to finish the registration."
msgstr "¡Tu familia ha sido creada! Ahora recibirás un correo para verificar tu dirección. Haz clic en el enlace del mensaje para terminar el registro."
