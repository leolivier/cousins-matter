msgstr "La conferma non corrisponde all'identificatore della famiglia. Operazione annullata."

#: views/views_manage.py:141
#, python-format
msgid "Family %(name)s permanently deleted."
msgstr "Famiglia %(name)s eliminata definitivamente."

