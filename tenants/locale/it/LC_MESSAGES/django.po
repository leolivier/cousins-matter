msgid ""
"Values left equal to the global defaults are not stored: a global change "
"will still apply to your family."
msgstr "I valori lasciati uguali ai valori globali predefiniti non vengono salvati: una modifica globale si applicherà comunque alla tua famiglia."

#: templates/tenants/tenant_settings.html:16
msgid "Save"
msgstr "Salva"

#: views/views_manage.py:39
msgid "Only platform administrators can manage families."
msgstr "Solo gli amministratori della piattaforma possono gestire le famiglie."

#: views/views_manage.py:48
